{
  "name": "niko-studio-backend",
  "version": "1.0.0",
  "description": "TypeScript backend for Niko Studio - migrated from Python",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node --esm src/index.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "async-lock": "^1.4.1",
    "better-sqlite3": "^12.8.0",
    "fastembed": "^2.1.0",
    "inversify": "^6.0.2",
    "inversify-binding-decorators": "^4.0.0",
    "mammoth": "^1.12.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.11.0",
    "@types/pdf-parse": "^1.1.5",
    "@vitest/coverage-v8": "^1.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^1.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
