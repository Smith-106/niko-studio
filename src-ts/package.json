{
  "name": "niko-studio-backend",
  "version": "9.26.2",
  "description": "TypeScript backend for Niko Studio - migrated from Python",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/postprocess_esm_imports.cjs",
    "lint": "eslint --config ../eslint.config.mjs \"**/*.{ts,tsx,mts}\" --max-warnings 0",
    "format": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --write \"package.json\" \"../eslint.config.mjs\" \"../prettier.config.mjs\"",
    "format:check": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --check \"package.json\" \"../eslint.config.mjs\" \"../prettier.config.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:phase2": "vitest run --config vitest.phase2.config.ts --coverage",
    "test:phase3": "vitest run --config vitest.phase3.config.ts",
    "test:coverage:phase3": "vitest run --config vitest.phase3.config.ts --coverage",
    "test:phase4": "vitest run --config vitest.phase4.config.ts",
    "test:coverage:phase4": "node -e \"require('fs').mkdirSync('coverage/.tmp',{recursive:true})\" && vitest run --config vitest.phase4.config.ts --coverage",
    "test:release": "vitest run --config vitest.release.config.ts",
    "typecheck": "tsc --noEmit",
    "check:quick": "npm run lint && npm run format:check && npm run typecheck && npm run test:phase4",
    "check:pre-commit": "npm run lint && npm run format:check",
    "check:release": "npm run lint && npm run format:check && npm run typecheck && npm run test:coverage:phase4 -- --coverage.reporter=text && npm run test:release",
    "check:local": "npm run check:release",
    "dev": "ts-node --esm src/index.ts",
    "consistency-check": "ts-node --esm consistency-check.ts",
    "benchmark": "vitest run tests/benchmark/gateway-benchmark.test.ts",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "@xenova/transformers": "^2.17.2",
    "async-lock": "^1.4.1",
    "better-sqlite3": "^12.9.0",
    "fastembed": "^2.1.0",
    "inversify": "^6.0.2",
    "inversify-binding-decorators": "^4.0.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "protobufjs": "^7.5.5",
    "tar": "^7.5.11"
  }
}
