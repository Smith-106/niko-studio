    "architecture": {
      "style": "Layered architecture with Platform Core + Domain Adapters pattern, combining multi-agent collaboration, memory management, and workflow orchestration",
      "layers": [
        "presentation: desktop/src (React/TypeScript frontend)",
        "business-logic: src/agents (multi-agent collaboration), src/workflow (5-level workflow engine), src/narrative (narrative engine), src/memory (OpenKL memory layer)",
        "data-access: src/graph (Kùzu graph database), src/store (document storage), src/db (SQLite database)",
        "services: src/services (platform services), src/mcp (MCP tools integration), src/search (smart search)",
        "cli: src/cli (command-line interface)"
      ],
      "patterns": [
        "Multi-Agent System",
        "Model Context Protocol (MCP)",
        "Workflow Engine",
        "Memory Layer (OpenKL)",
        "Knowledge Graph",
        "Citation System",
        "Repository Pattern",
        "Factory Pattern",
        "Strategy Pattern"
      ]
    },
    "key_components": [
      {
        "name": "Narrative Engine",
        "path": "src/narrative",
        "description": "Core narrative generation and management system with story planning, character development, and plot construction capabilities",
        "importance": "high"
      },
      {
        "name": "Workflow Engine",
        "path": "src/workflow",
        "description": "5-level workflow orchestration system (Rapid → Lite → Standard → Brainstorm → Coordinator) with session management and resume strategies",
        "importance": "high"
      },
      {
        "name": "Memory Layer",
        "path": "src/memory",
        "description": "OpenKL-based memory management with temporal organization, topic symlinks, vector search (FastEmbed 384-dim), and citation system",
        "importance": "high"
      },
      {
        "name": "Agent System",
        "path": "src/agents",
        "description": "Multi-agent collaboration framework including Commander, Architect, Writer, Critic, Plot, Character, Worldbuilding, and Skill Router agents",
        "importance": "high"
      },
      {
        "name": "MCP Integration",
        "path": "src/mcp",
        "description": "Model Context Protocol tools and servers integration for external CLI and service orchestration",
        "importance": "high"
      },
      {
        "name": "Services Layer",
        "path": "src/services",
        "description": "Platform services including BackupManager, TokenService, ObsidianService, and Reranker with 4 strategies",
        "importance": "high"
      },
      {
        "name": "Knowledge Graph",
        "path": "src/graph",
        "description": "Kùzu graph database manager with HNSW indexes, Cypher query support, and cross-domain relations",
        "importance": "medium"
      },
      {
        "name": "Smart Search",
        "path": "src/search",
        "description": "Hybrid search system combining fuzzy (FTS + ripgrep) and semantic (Embedding + RRF) search strategies",
        "importance": "medium"
      },
      {
        "name": "Desktop Application",
        "path": "desktop/src",
        "description": "Tauri-based desktop client with React frontend, providing native UI for the AI Agent platform",
        "importance": "high"
      },
      {
        "name": "Tauri Sidecar",
        "path": "desktop/src-tauri",
        "description": "Rust-based sidecar providing gateway services and native integrations for the desktop application",
        "importance": "medium"
      }
    ]
  },
