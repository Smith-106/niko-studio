# Niko-Studio 环境变量示例
# 复制为 .env 后按需修改

# ============================================================
# 运行环境
# ============================================================
NIKO_ENV=development
NIKO_DEBUG=false

# ============================================================
# LLM 凭证（至少配置一个 Provider）
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=                    # 自定义 API 端点（可选）
# OPENAI_MODEL_FAST=gpt-4o-mini       # 快速模型（可选）
# OPENAI_MODEL_DEFAULT=gpt-4o         # 默认模型（可选）
# OPENAI_MODEL_POWERFUL=gpt-4-turbo   # 强力模型（可选）
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google ---
GOOGLE_API_KEY=

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_FAST=claude-3-haiku-20240307
# ANTHROPIC_MODEL_DEFAULT=claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL_POWERFUL=claude-3-opus-20240229

# --- Azure OpenAI ---
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=              # 例如 https://xxx.openai.azure.com
# AZURE_MODEL_FAST=gpt-4o-mini
# AZURE_MODEL_DEFAULT=gpt-4o
# AZURE_MODEL_POWERFUL=gpt-4-turbo
# AZURE_EMBEDDING_MODEL=text-embedding-3-small

# --- 本地模型 (Ollama 等) ---
# LOCAL_LLM_BASE_URL=                 # 例如 http://localhost:11434
# LOCAL_MODEL_FAST=llama3
# LOCAL_MODEL_DEFAULT=llama3
# LOCAL_MODEL_POWERFUL=llama3
# LOCAL_EMBEDDING_MODEL=bge-large-zh-v1.5

# ============================================================
# Provider 路由（默认 openai）
# ============================================================
# LLM_DEFAULT_PROVIDER=openai
# EMBEDDING_DEFAULT_PROVIDER=openai

# ============================================================
# 模型与成本控制
# ============================================================
NIKO_DEFAULT_MODEL=gpt-4o
NIKO_MAX_COST_PER_REQUEST=1.0
NIKO_MAX_COST_PER_SESSION=10.0

# ============================================================
# 存储路径
# ============================================================
NIKO_VECTOR_DB_PATH=.writing/vector_store
NIKO_GRAPH_DB_PATH=.writing/graph_db
# NIKO_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================
# 缓存与重试
# ============================================================
# EMBEDDING_CACHE_ENABLED=true
# EMBEDDING_CACHE_TTL=86400
# EMBEDDING_CACHE_MAX_SIZE=10000
# RETRY_MAX_ATTEMPTS=3
# RETRY_INITIAL_DELAY=1.0
# RETRY_MAX_DELAY=60.0
# RETRY_EXPONENTIAL_BASE=2.0
# HEALTH_CHECK_INTERVAL=60

# ============================================================
# Reranker（可选）
# ============================================================
# RERANKER_TYPE=                       # cross_encoder / cohere / jina
# RERANKER_MODEL=
# RERANKER_TIMEOUT=30.0
# RERANKER_MAX_RETRIES=3

# ============================================================
# Web UI（可选）
# ============================================================
# WEB_UI_FORWARD_URL=
