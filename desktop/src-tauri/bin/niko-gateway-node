#!/usr/bin/env node

import fs from 'node:fs';
import http from 'node:http';
import https from 'node:https';
import path from 'node:path';
import { spawn } from 'node:child_process';
import { createRequire } from 'node:module';
import { fileURLToPath, pathToFileURL } from 'node:url';

const require = createRequire(import.meta.url);
const __dirname = path.dirname(fileURLToPath(import.meta.url));

function trimTrailingSlash(value) {
  return value.replace(/\/+$/, '');
}

function getBaseUrl() {
  const env = process.env;
  const raw = env.NIKO_GATEWAY_SHADOW_UPSTREAM || env.NIKO_GATEWAY_URL || env.VITE_NIKO_GATEWAY_URL || 'http://127.0.0.1:8000';
  return trimTrailingSlash(String(raw || 'http://127.0.0.1:8000'));
}

function getListenHost() {
  const host = (process.env.NIKO_GATEWAY_HOST || '127.0.0.1').trim();
  return host || '127.0.0.1';
}

function getListenPort() {
  const parsed = Number.parseInt(process.env.NIKO_GATEWAY_PORT || '8000', 10);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : 8000;
}

function resolveRepoRoot() {
  return path.resolve(__dirname, '..', '..', '..');
}

function resolveTypeScriptGateway() {
  const overrideEntry = (process.env.NIKO_GATEWAY_TS_ENTRY || '').trim();
  const repoRoot = resolveRepoRoot();
  const projectDir = path.join(repoRoot, 'src-ts');
  const entry = overrideEntry || path.join(projectDir, 'gateway-server.ts');

  if (!fs.existsSync(entry)) {
    return null;
  }

  try {
    const loader = require.resolve('ts-node/esm', { paths: [projectDir] });
    return {
      entry,
      loader,
      cwd: projectDir,
    };
  } catch {
    return null;
  }
}

function tryLaunchRealGateway() {
  const realGateway = resolveTypeScriptGateway();
  if (!realGateway) {
    return null;
  }

  const repoRoot = resolveRepoRoot();
  const nodeMajor = Number.parseInt(String(process.versions.node || '0').split('.')[0] || '0', 10);
  const entryPath = `./${path.relative(realGateway.cwd, realGateway.entry).replace(/\\/g, '/')}`;

  const args = [];
  if (Number.isFinite(nodeMajor) && nodeMajor >= 24) {
    const loaderUrl = pathToFileURL(realGateway.loader).href;
    const importScript =
      "data:text/javascript,import { register } from 'node:module'; import { pathToFileURL } from 'node:url'; register(" +
      JSON.stringify(loaderUrl) +
      ", pathToFileURL('./'));";
    args.push('--import', importScript);
  } else {
    args.push('--loader', pathToFileURL(realGateway.loader).href);
  }

  args.push(
    '--experimental-specifier-resolution=node',
    entryPath,
    '--host',
    getListenHost(),
    '--port',
    String(getListenPort()),
  );

  const child = spawn(process.execPath, args, {
    cwd: realGateway.cwd,
    stdio: 'inherit',
    env: {
      ...process.env,
      NIKO_GATEWAY_HOST: getListenHost(),
      NIKO_GATEWAY_PORT: String(getListenPort()),
      NIKO_WORKFLOW_WORKSPACE: process.env.NIKO_WORKFLOW_WORKSPACE || repoRoot,
    },
  });

  child.on('exit', (code, signal) => {
    if (signal) {
      process.kill(process.pid, signal);
      return;
    }
    process.exit(code ?? 0);
  });

  child.on('error', (error) => {
    console.error(`[niko-gateway-node] failed to launch TypeScript gateway: ${error.message}`);
  });

  const forwardSignal = (signal) => {
    if (!child.killed) {
      child.kill(signal);
    }
  };
  process.on('SIGTERM', () => forwardSignal('SIGTERM'));
  process.on('SIGINT', () => forwardSignal('SIGINT'));

  console.log(`[niko-gateway-node] launched real TypeScript gateway on ${getListenHost()}:${getListenPort()}`);
  return child;

}

function writeJson(res, code, payload) {
  const body = JSON.stringify(payload);
  res.writeHead(code, {
    'content-type': 'application/json; charset=utf-8',
    'content-length': Buffer.byteLength(body),
  });
  res.end(body);
}

function checkUpstreamHealth(upstreamBase) {
  return new Promise((resolve) => {
    const healthUrl = new URL('/health', `${upstreamBase}/`);
    const client = healthUrl.protocol === 'https:' ? https : http;
    const req = client.request(
      {
        protocol: healthUrl.protocol,
        hostname: healthUrl.hostname,
        port: healthUrl.port || (healthUrl.protocol === 'https:' ? 443 : 80),
        method: 'GET',
        path: `${healthUrl.pathname}${healthUrl.search}`,
      },
      (res) => {
        resolve({
          ok: (res.statusCode || 500) >= 200 && (res.statusCode || 500) < 300,
          statusCode: res.statusCode || 500,
        });
        res.resume();
      },
    );

    req.on('error', (error) => {
      resolve({
        ok: false,
        statusCode: 502,
        error: error.message,
      });
    });
    req.setTimeout(1500, () => {
      req.destroy(new Error('upstream health timeout'));
    });
    req.end();
  });
}

function startShadowProxy() {
  const upstreamBase = getBaseUrl();
  const upstreamUrl = new URL(upstreamBase);
  const upstreamClient = upstreamUrl.protocol === 'https:' ? https : http;

  const server = http.createServer(async (req, res) => {
    if (req.url === '/health') {
      const health = await checkUpstreamHealth(upstreamBase);
      if (health.ok) {
        writeJson(res, 200, {
          status: 'healthy',
          runtime: 'node-shadow',
          upstream: upstreamBase,
          timestamp: new Date().toISOString(),
        });
      } else {
        writeJson(res, health.statusCode || 502, {
          status: 'unhealthy',
          runtime: 'node-shadow',
          upstream: upstreamBase,
          detail: health.error || 'upstream health check failed',
          timestamp: new Date().toISOString(),
        });
      }
      return;
    }

    const targetUrl = new URL(req.url || '/', upstreamBase);
    const proxyReq = upstreamClient.request(
      {
        protocol: targetUrl.protocol,
        hostname: targetUrl.hostname,
        port: targetUrl.port || (targetUrl.protocol === 'https:' ? 443 : 80),
        method: req.method,
        path: `${targetUrl.pathname}${targetUrl.search}`,
        headers: req.headers,
      },
      (proxyRes) => {
        res.writeHead(proxyRes.statusCode || 502, proxyRes.headers);
        proxyRes.pipe(res);
      },
    );

    proxyReq.on('error', (error) => {
      writeJson(res, 502, {
        error: 'Node shadow proxy failed',
        detail: error.message,
        upstream: upstreamBase,
      });
    });

    req.pipe(proxyReq);
  });

  server.listen(getListenPort(), getListenHost(), () => {
    console.log(`[niko-gateway-node] listening on ${getListenHost()}:${getListenPort()} -> ${upstreamBase}`);
  });

  function shutdown() {
    server.close(() => process.exit(0));
  }

  process.on('SIGTERM', shutdown);
  process.on('SIGINT', shutdown);
}

const realGatewayChild = tryLaunchRealGateway();
if (!realGatewayChild) {
  startShadowProxy();
}
