{
  "name": "niko-studio-desktop",
  "version": "8.2.0",
  "description": "Niko-Studio Desktop - AI Writing Assistant",
  "type": "module",
  "scripts": {
    "ensure-deps": "node -e \"const fs=require('fs');const cp=require('child_process');if(!fs.existsSync('node_modules/typescript/bin/tsc')){console.log('Dependencies missing, running npm ci...');cp.execSync('npm ci',{stdio:'inherit'});}\"",
    "check:node-sidecar": "node --check src-tauri/bin/niko-gateway-node",
    "validate:sidecar-contract": "node scripts/validate_sidecar_contract.cjs --strict",
    "build:sidecar:python": "python ../../scripts/build_gateway_sidecar.py",
    "build:sidecar:node": "npm run check:node-sidecar && echo 'Node sidecar ready (no build required)'",
    "build:sidecar:choose": "node scripts/choose_sidecar.cjs",
    "build:sidecar": "npm run build:sidecar:choose",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\" && vitest run --reporter=default --reporter=junit --outputFile.junit=test-results/vitest.junit.xml",
    "check": "npm run typecheck && npm run build",
    "build": "npm run ensure-deps && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "npm run build:sidecar && tauri dev",
    "tauri:build": "npm run build:sidecar && tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "autoprefixer": "^10.4.18",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
