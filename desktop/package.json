{
  "name": "niko-studio-desktop",
  "version": "11.0.4",
  "description": "Niko-Studio Desktop - AI Writing Assistant",
  "type": "module",
  "scripts": {
    "ensure-deps": "node -e \"const fs=require('fs');const cp=require('child_process');if(!fs.existsSync('node_modules/typescript/bin/tsc')){console.log('Dependencies missing, running npm ci...');cp.execSync('npm ci',{stdio:'inherit'});}\"",
    "check:node-sidecar": "node --check src-tauri/bin/niko-gateway-node",
    "validate:sidecar-contract": "node scripts/validate_sidecar_contract.cjs --strict",
    "build:sidecar:python": "python ../scripts/build_gateway_sidecar.py",
    "build:sidecar:node": "npm run check:node-sidecar && node scripts/build_node_sidecar.cjs",
    "build:sidecar:node:fast": "npm run check:node-sidecar && echo 'Node sidecar smoke-only (no bundle staging)'",
    "build:sidecar:choose": "node scripts/choose_sidecar.cjs",
    "build:sidecar": "npm run build:sidecar:choose",
    "dev": "vite",
    "lint": "eslint --config ../eslint.config.mjs \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,cjs,mjs}\" \"vite.config.ts\" --max-warnings 0",
    "format": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --write \"package.json\" \"../eslint.config.mjs\" \"../prettier.config.mjs\"",
    "format:check": "prettier --config ../prettier.config.mjs --ignore-path ../.prettierignore --check \"package.json\" \"../eslint.config.mjs\" \"../prettier.config.mjs\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .",
    "test:stable": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --root . --maxWorkers=4",
    "test:serial": "node --max-old-space-size=8192 ./node_modules/vitest/vitest.mjs run --root . --maxWorkers=1 --fileParallelism=false",
    "test:watch": "vitest --root .",
    "test:ci": "node -e \"require('fs').mkdirSync('test-results',{recursive:true})\" && vitest run --root . --reporter=default --reporter=junit --outputFile.junit=test-results/vitest.junit.xml",
    "check:quick": "npm run lint && npm run format:check && npm run typecheck && npm run check:node-sidecar && npm run validate:sidecar-contract && npm run test",
    "check:pre-commit": "npm run lint && npm run format:check",
    "check:release": "npm run lint && npm run format:check && npm run test:serial && npm run build:sidecar && npm run validate:sidecar-contract && npm run build",
    "check:local": "npm run check:release",
    "check": "npm run typecheck && npm run build",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start_desktop_local.ps1",
    "local:start:force": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start_desktop_local.ps1 -ForceDesktop",
    "local:start:binary": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start_desktop_local.ps1 -BinaryDesktop",
    "local:start:binary:force": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start_desktop_local.ps1 -BinaryDesktop -ForceDesktop",
    "local:gateway": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/start_desktop_local.ps1 -NoDesktop",
    "local:shell": "node scripts/run_local_vite_shell.cjs",
    "local:status": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/status_desktop_local.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/stop_desktop_local.ps1",
    "local:selftest": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/selftest_desktop_local.ps1",
    "local:pre-commit": "python ../scripts/run_local_pre_commit.py",
    "package:e2e:checklist": "python ../scripts/package_e2e_checklist.py",
    "audit:high": "npm audit --audit-level=high",
    "release:evidence:refresh": "python ../scripts/refresh_release_evidence.py",
    "hydrate:packaged-compat": "node scripts/hydrate_packaged_compat_artifact.cjs",
    "validate:package:dry-run": "npm run hydrate:packaged-compat && node scripts/validate_sidecar_contract.cjs --strict --strict-packaging && npm run tauri -- build --debug --no-bundle --target x86_64-pc-windows-msvc",
    "build": "npm run ensure-deps && tsc && vite build",
    "preview": "vite preview",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "sign:prepare-config": "python ../scripts/generate_signed_tauri_config.py",
    "build:packaged-compat": "npm run build:sidecar && cargo build --release --bin niko-gateway-launcher --manifest-path src-tauri/Cargo.toml && npm run hydrate:packaged-compat",
    "tauri:build:signed": "npm run build:packaged-compat && python ../scripts/generate_signed_tauri_config.py --run-build",
    "tauri:dev": "npm run build:sidecar && npm run tauri -- dev",
    "tauri:build": "npm run build:packaged-compat && npm run tauri -- build"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@sentry/react": "^10.51.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@tiptap/extension-blockquote": "^3.22.0",
    "@tiptap/extension-bullet-list": "^3.22.0",
    "@tiptap/extension-character-count": "^3.22.0",
    "@tiptap/extension-code-block": "^3.22.0",
    "@tiptap/extension-heading": "^3.22.0",
    "@tiptap/extension-horizontal-rule": "^3.22.0",
    "@tiptap/extension-ordered-list": "^3.22.0",
    "@tiptap/extension-placeholder": "^3.22.0",
    "@tiptap/extension-table": "^3.22.5",
    "@tiptap/extension-table-cell": "^3.22.5",
    "@tiptap/extension-table-header": "^3.22.5",
    "@tiptap/extension-table-row": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.0",
    "@tiptap/extension-typography": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.0",
    "@tiptap/pm": "^3.22.0",
    "@tiptap/react": "^3.22.0",
    "@tiptap/starter-kit": "^3.22.0",
    "clsx": "^2.1.0",
    "cytoscape": "^3.33.4",
    "cytoscape-cose-bilkent": "^4.1.0",
    "diff": "^9.0.0",
    "docx": "^9.6.1",
    "i18next": "^26.0.6",
    "katex": "^0.16.45",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.1",
    "tippy.js": "^6.3.7",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^5.2.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cytoscape": "^3.21.9",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-istanbul": "^3.2.6",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.36.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.35",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "vite": "^7.3.5",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "ws": "^8.21.0"
  }
}
